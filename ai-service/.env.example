# LoanChain AI Verification Service Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Ethereum Sepolia RPC & Contracts
RPC_URL=https://rpc.sepolia.org
DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
AI_ATTESTATION_ADDRESS=0x0000000000000000000000000000000000000000
LOAN_APPLICATION_ADDRESS=0x0000000000000000000000000000000000000000
ISSUER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# AI Signer Private Key (Generate using tools/gen_dev_signer.py)
# NEVER commit the real private key to git!
AI_SIGNER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service configuration
THRESHOLDS_PATH=config/thresholds.yaml
DATABASE_URL=sqlite:///data/reports.db
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10
MAX_PAGES=20
