# LoanChain Frontend — Environment Variables
# Copy this file to .env and fill in your deployed contract addresses

# ── Deployed Contract Addresses (after Remix IDE deployment on Sepolia) ───────
VITE_ISSUER_REGISTRY=0x0000000000000000000000000000000000000000
VITE_DOC_REGISTRY=0x0000000000000000000000000000000000000000
VITE_CONSENT_MANAGER=0x0000000000000000000000000000000000000000
VITE_LOAN_APPLICATION=0x0000000000000000000000000000000000000000
VITE_AI_ATTESTATION=0x0000000000000000000000000000000000000000

# ── AI Verification Service URL ───────────────────────────────────────────────
VITE_AI_SERVICE_URL=http://localhost:8000

# ── Pinata IPFS Configuration (Public Gateway) ────────────────────────────────
# Generate your free JWT or API Key at https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=
